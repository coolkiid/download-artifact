{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./lib",
    "strict": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false
  },
  "exclude": ["node_modules", "**/*.test.ts", "**/__tests__/*.ts"]
}